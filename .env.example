# Любой OpenAI-совместимый провайдер. Проверено на Ollama Cloud с gpt-oss:120b.
LLM_BASE_URL=https://ollama.com/v1
LLM_API_KEY=ваш-ключ
LLM_MODEL=gpt-oss:120b
LLM_TEMPERATURE=0.2
LLM_TIMEOUT=180
LLM_MAX_REPAIRS=2

# Локальная Ollama: LLM_BASE_URL=http://localhost:11434/v1, ключ — любой непустой.
# В Docker вместо localhost — host.docker.internal.

# Если Docker Hub недоступен, базовый образ можно взять из зеркала:
# BASE_IMAGE=mirror.gcr.io/library/python:3.11-slim
