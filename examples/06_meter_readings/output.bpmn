<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Pool_1" name="Процесс" processRef="Process_Pool_1"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_Pool_1" name="Процесс" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Pool_1">
      <bpmn:lane id="Lane_1" name="Абонент">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="Личный кабинет">
        <bpmn:flowNodeRef>EndEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ScriptTask_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ScriptTask_4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_3" name="Биллинг">
        <bpmn:flowNodeRef>ScriptTask_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ExclusiveGateway_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ScriptTask_3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_4" name="Контролёр">
        <bpmn:flowNodeRef>UserTask_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_4</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="EndEvent_1">
      <bpmn:incoming>Flow_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="UserTask_1" name="Ввести показания">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:scriptTask id="ScriptTask_1" name="Проверить формат и сохранить">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway_1" name="Показания переданы до 25 числа?">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="ScriptTask_2" name="Вычислить среднее показание">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="ExclusiveGateway_2" name="Подозрительные показания?">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UserTask_2" name="Выезд контролёра">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask_3" name="Снять фактические показания">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask_4" name="Составить акт проверки">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:scriptTask id="ScriptTask_3" name="Сформировать счёт">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:scriptTask id="ScriptTask_4" name="Отправить счёт в личный кабинет">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="UserTask_1"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="UserTask_1" targetRef="ScriptTask_1"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="ScriptTask_1" targetRef="ExclusiveGateway_1"/>
    <bpmn:sequenceFlow id="Flow_4" name="да" sourceRef="ExclusiveGateway_1" targetRef="ExclusiveGateway_2"/>
    <bpmn:sequenceFlow id="Flow_5" name="нет" sourceRef="ExclusiveGateway_1" targetRef="ScriptTask_2"/>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="ScriptTask_2" targetRef="ExclusiveGateway_2"/>
    <bpmn:sequenceFlow id="Flow_7" name="нет" sourceRef="ExclusiveGateway_2" targetRef="ScriptTask_3"/>
    <bpmn:sequenceFlow id="Flow_8" name="да" sourceRef="ExclusiveGateway_2" targetRef="UserTask_2"/>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="UserTask_2" targetRef="UserTask_3"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="UserTask_3" targetRef="UserTask_4"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="UserTask_4" targetRef="ScriptTask_3"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="ScriptTask_3" targetRef="ScriptTask_4"/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="ScriptTask_4" targetRef="EndEvent_1"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Pool_1_di" bpmnElement="Pool_1" isHorizontal="true">
