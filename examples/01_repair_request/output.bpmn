    <bpmn:sequenceFlow id="Flow_14" sourceRef="UserTask_7" targetRef="UserTask_8"/>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="UserTask_8" targetRef="ScriptTask_1"/>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="ScriptTask_1" targetRef="EndEvent_1"/>
  </bpmn:process>
